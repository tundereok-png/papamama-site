---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 10);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 1em 0 2em;
			}
			.hero h1 {
				color: var(--accent);
				font-size: 2em;
				margin-bottom: 0.3em;
			}
			.categories {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 0.8em;
				margin: 1em 0 2.5em;
				padding: 0;
				list-style: none;
			}
			.categories li {
				padding: 0.8em;
				border-radius: 12px;
				background: white;
				box-shadow: 0 2px 6px rgba(var(--gray), 25%);
				text-align: center;
				font-weight: bold;
			}
			.posts {
				list-style: none;
				padding: 0;
			}
			.posts li {
				padding: 0.8em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.posts a {
				text-decoration: none;
				color: rgb(var(--black));
				font-weight: bold;
			}
			.posts a:hover {
				color: var(--accent);
			}
			.posts .meta {
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>

			<h2>カテゴリー</h2>
			<ul class="categories">
				{Object.values(CATEGORIES).map((name) => <li>{name}</li>)}
			</ul>

			<h2>新着記事</h2>
			{latest.length === 0 && <p>記事を準備中です。</p>}
			<ul class="posts">
				{latest.map((post) => (
					<li>
						<div class="meta">
							{CATEGORIES[post.data.category]} ／ <FormattedDate date={post.data.pubDate} />
						</div>
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					</li>
				))}
			</ul>
			<p><a href="/blog">記事一覧を見る →</a></p>
		</main>
		<Footer />
	</body>
</html>
